---
// Page shell for every view: head, nav and the footer that says where the data comes from.
import '../styles/global.css';

interface Props { view: 'voda' | 'podatki' | 'naprava' | 'nastavitve'; title: string; showNavigation?: boolean }
const { view, title, showNavigation = true } = Astro.props;

const NAV = [
  { id: 'voda', href: '/', label: 'Voda', icon: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>' },
  { id: 'podatki', href: '/podatki', label: 'Podatki', icon: '<path d="M4 19h16M6 15l4-5 4 3 5-7"/>' },
  { id: 'naprava', href: '/naprava', label: 'Naprava', icon: '<rect x="6" y="3" width="12" height="18" rx="3"/><path d="M10 17h4"/>' },
  { id: 'nastavitve', href: '/nastavitve', label: 'Nastavitve', icon: '<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>' },
];
---
<!doctype html>
<html lang="sl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f4f6f8">
  <!-- Theme before first paint: saved choice, else system setting. Button #theme switches it. -->
  <script is:inline>
    const root = document.documentElement, meta = document.querySelector('meta[name=theme-color]');
    const apply = t => { root.dataset.theme = t; meta.content = t === 'dark' ? '#0f1318' : '#f4f6f8'; };
    let saved; try { saved = localStorage.getItem('theme'); } catch {}
    apply(saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
    document.addEventListener('click', e => {
      if (!e.target.closest('#theme')) return;
      const t = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(t);
      try { localStorage.setItem('theme', t); } catch {}
    });
  </script>
  <title>{title} · BioSens</title>
</head>
<body class={`px-4 pt-4 ${showNavigation ? 'pb-[calc(116px+env(safe-area-inset-bottom))]' : 'pb-[calc(16px+env(safe-area-inset-bottom))]'} bg-page font-sans text-[20px] text-ink antialiased md:px-8 md:pt-5 md:pb-4 md:text-[19px]`}>
  <header class="flex items-center justify-end gap-3 max-w-page mx-auto mb-3 md:mb-6">
    {showNavigation && <>
    <span class="hidden mr-auto text-[24px] font-extrabold tracking-[-0.02em] text-accent md:block">BioSens</span>
    <!-- Bottom tab bar on phones, pill switch at the top on larger screens -->
    <nav class="fixed inset-x-0 bottom-0 z-10 grid grid-cols-[repeat(4,1fr)] p-2 pb-[calc(8px+env(safe-area-inset-bottom))] border-t border-line bg-card/92 backdrop-blur-md md:static md:grid-cols-[repeat(4,auto)] md:gap-1 md:p-1.5 md:border-0 md:rounded-full md:shadow-card" aria-label="Pogled">
      {NAV.map(item => (
        <a href={item.href} aria-current={item.id === view ? 'page' : undefined}
          class="grid justify-items-center gap-0.5 min-h-17 px-0.5 py-1.5 rounded-2xl text-[16px] font-[650] text-muted no-underline aria-[current=page]:bg-accent-bg aria-[current=page]:text-accent md:flex md:items-center md:justify-center md:gap-2 md:min-h-12 md:px-4.5 md:py-0 md:rounded-full md:text-[17px] md:aria-[current=page]:bg-accent md:aria-[current=page]:text-on-accent">
          <svg class="size-7.5 md:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />{item.label}
        </a>
      ))}
    </nav>
    </>}
    <button type="button" id="theme" class="grid flex-none place-items-center size-12 rounded-full bg-card text-ink shadow-card" aria-label="Svetlo ali temno" title="Svetlo ali temno">
      <svg class="size-6 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg>
      <svg class="hidden size-6 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </header>
  <main class="max-w-page mx-auto">
    <slot />
  </main>
  <footer id="source" class="max-w-page mx-auto mt-10 text-[16px] text-center text-muted"></footer>
</body>
</html>
