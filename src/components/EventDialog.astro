---
// Detail sheet for one event. Filled and opened by openEvent() in scripts/event-dialog.mjs.
// Bottom sheet on phones, centred card on desktop.
---
<dialog id="event-dialog" aria-label="Podrobnosti dogodka"
  class="w-full max-w-[760px] max-h-[92vh] mt-auto mx-auto mb-0 px-4.5 pt-5 pb-[calc(20px+env(safe-area-inset-bottom))] rounded-t-card bg-page text-ink shadow-card backdrop:bg-ink/45 md:m-auto md:p-7 md:rounded-card">
  <div id="event-body"></div>
  <button type="button" id="event-close" class="sticky bottom-0 block w-full min-h-15 mt-5 rounded-full bg-accent font-bold text-white shadow-card">Zapri</button>
</dialog>
