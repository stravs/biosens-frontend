---
// Voda: for everyone. One big answer, four cards and notable events.
import Layout from '../layouts/Layout.astro';
import EventDialog from '../components/EventDialog.astro';
---
<Layout view="voda" title="Voda">
  <section id="everyone">
    <h1 id="status" class="status"></h1>
    <div id="cards" class="cards"></div>
    <h2>Posebni dogodki v zadnjih 24 urah</h2>
    <ul id="events" class="events"></ul>
  </section>
  <EventDialog />
</Layout>

<script>import '../scripts/voda.mjs';</script>
