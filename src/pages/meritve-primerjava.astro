---
import Layout from '../layouts/Layout.astro';
import { SAMPLES } from '../data/measurements.mjs';
import marcel from '../data/marcel.json';
import { COMPARISON_FIELDS as fields, formatComparison as fmt } from '../lib/measurement-comparison.mjs';
const serial = SAMPLES.map(s => ({ id: s.id, label: s.label, count: s.rows.filter(r => !r.reason).length,
  invalid: s.rows.filter(r => r.reason).length, crc: s.crcErrors,
  values: fields.map(f => s.stats[f.column].mean), sd: fields.map(f => s.stats[f.column].sd) }));
const groups = [
  { label: 'Reke · 29. 10. 2021', date: '2021-10-29', group: 'river' },
  { label: 'Reke · 9. 12. 2021', date: '2021-12-09', group: 'river' },
  { label: 'Vodovod · 29. 10. 2021', date: '2021-10-29', group: 'tap' },
  { label: 'Vodovod · 9. 12. 2021', date: '2021-12-09', group: 'tap' },
].map(g => ({ ...g, rows: marcel.filter(r => r.date === g.date && r.group === g.group) }));
const range = (rows, i) => {
  const v = rows.map(r => r.values[i]).filter(Number.isFinite);
  return v.length ? `${fmt(Math.min(...v), fields[i].digits)}–${fmt(Math.max(...v), fields[i].digits)}` : '—';
};
---
<Layout view="naprava" title="Meritve · primerjava" showNavigation={false}>
  <a href="/meritve" class="text-[16px] font-semibold text-accent">← Serijske meritve</a>
  <header class="mb-6 mt-4">
    <p class="mb-2 text-[14px] font-bold uppercase tracking-widest text-accent">BioSens · primerjava meritev</p>
    <h1 class="m-0 text-[32px] font-bold tracking-tight md:text-[42px]">Isti parametri. Različni preizkusi.</h1>
    <p class="mt-3 max-w-3xl text-[17px] text-muted">Serijski vzorci z dne 2. 11. 2026, Marcelovi veljavni preizkusi iz leta 2021 in zadnji podatki delujoče naprave. Razlike niso dokaz spremembe kakovosti vode.</p>
  </header>
  <div class="grid gap-4 md:grid-cols-3">
    {[
      ['2026', 'Pet serijskih vzorcev', 'Vsi veljavni odčitki, ne le prvih pet kot na strani Meritve.'],
      ['2021', 'Samo veljavni Marcelovi rezultati', '29. oktober in 9. december. Meritve 2. decembra so izločene zaradi napačnih tokovnih nastavitev.'],
      ['V živo', 'Zadnji paket + pet odčitkov', 'Podatki API, brez simulacije. Čas prejema je prikazan; vzorec tekočega preizkusa ni potrjen.'],
    ].map(([tag, title, note]) => <section class="rounded-card bg-card p-5 shadow-card"><span class="text-[14px] font-bold text-accent">{tag}</span><h2 class="my-2 text-[20px]">{title}</h2><p class="m-0 text-[15px] text-muted">{note}</p></section>)}
  </div>
  <aside class="my-5 rounded-card border border-amber-500/40 bg-amber-500/10 p-5 text-[16px]">
    <strong>Kalibracija ni potrjena.</strong> Dnevnik vodovodne vode kaže napako CRC in nalaganje privzetih koeficientov. Pri drugih serijskih vzorcih koeficienti niso zapisani. Nephelometer uporablja različne možne lestvice; stolpca ne primerjamo kot NTU.
  </aside>

  <section id="live-comparison" data-serial={JSON.stringify(serial)} class="mt-6 rounded-card bg-card p-4 shadow-card md:p-6" aria-labelledby="live-title">
    <div class="flex flex-wrap items-center justify-between gap-3"><h2 id="live-title" class="m-0 text-[24px]">Tekoča meritev</h2><button id="comparison-refresh" type="button" class="min-h-11 rounded-full bg-accent px-5 py-2 text-[16px] font-semibold text-on-accent disabled:opacity-50">Osveži</button></div>
    <p class="text-[14px] text-muted">Vir: <a href="https://biosens-frontend.stravs-a.workers.dev/" class="text-accent">delujoča naprava</a> · samodejno osveževanje na 2 minuti.</p>
    <p id="comparison-status" role="status" class="text-[16px]">Nalaganje dejanskih meritev …</p>
    <noscript><p>Za tekoče meritve omogočite JavaScript. Zgodovinske tabele so na voljo spodaj.</p></noscript>
    <div id="comparison-live" hidden>
      <label for="comparison-sample" class="mb-2 block text-[16px] font-semibold">Primerjaj s serijskim vzorcem</label>
      <select id="comparison-sample" class="mb-4 min-h-12 w-full rounded-xl border border-line bg-card px-4 py-2 text-[17px] text-ink md:w-auto">{serial.map(s => <option value={s.id}>{s.label} · {s.count} odčitkov</option>)}</select>
      <div class="overflow-x-auto"><table class="w-full min-w-[1100px] text-left text-[15px] tabular-nums">
        <caption class="sr-only">Zadnji paket, povprečje zadnjih petih uporabnih paketov in serijski vzorec</caption>
        <thead><tr>{['Parameter', 'Zadnji paket', 'Zadnjih do 5', 'Serijski vzorec', 'Razlika zadnji − vzorec', 'Marcel · oktober', 'Marcel · december'].map(t => <th scope="col" class="p-3 text-muted">{t}</th>)}</tr></thead>
        <tbody id="comparison-live-body"></tbody>
      </table></div>
      <p id="comparison-live-meta" class="text-[14px] text-muted"></p>
    </div>
    <p class="text-[14px] text-muted">Marcelova razpona sledita izbranemu serijskemu vzorcu: vodovod ali vse reke. To ne določa vrste vode v tekočem preizkusu; za ostale vzorce ni ustrezne zgodovinske reference. Noben razpon ni varnostni prag.</p>
    <p class="text-[14px] text-muted">¹ LoRa pošilja EC25. Za primerjavo ocenimo EC = EC25 × [1 + 0,020 × (T − 25)], po aktivni kodi FW2. To ni potrjena kalibracija naprave. Ničelne in nasičene prenose izločimo, ker lahko pomenijo omejitev paketa; veljavnosti ostalih meritev s tem ne potrdimo. Motnosti ne odštevamo.</p>
  </section>

  <section class="mt-6 rounded-card bg-card p-4 shadow-card md:p-6" aria-labelledby="serial-title">
    <h2 id="serial-title" class="mt-0 text-[24px]">Serijski vzorci · 2. 11. 2026</h2>
    <p class="text-[15px] text-muted">Povprečje ± vzorčni standardni odklon vseh veljavnih, popolnih odčitkov. Brez časovnih oznak; datuma ne sklepamo iz časa prejema.</p>
    <div class="overflow-x-auto"><table class="w-full min-w-[850px] text-left text-[15px] tabular-nums">
      <caption class="sr-only">Statistika petih serijskih vzorcev</caption>
      <thead><tr><th scope="col" class="p-3">Vzorec / n</th>{fields.map(f => <th scope="col" class="p-3">{f.label}<span class="block text-[12px] font-normal text-muted">{f.unit}</span></th>)}</tr></thead>
      <tbody>{serial.map(s => <tr class="border-t border-line"><th scope="row" class="p-3 font-semibold">{s.label}<span class="block text-[13px] font-normal text-muted">n = {s.count}{s.invalid ? ` · izločeno: ${s.invalid}` : ''}</span></th>{s.values.map((v,i) => <td class="p-3">{fmt(v,fields[i].digits)}<span class="block text-[12px] text-muted">± {fmt(s.sd[i],fields[i].digits)}</span></td>)}</tr>)}</tbody>
    </table></div>
    <p class="text-[14px] text-muted">Izločen je en vodovodni zagonski odčitek (−255,94 °C, negativna EC, ničelni spekter). Pri deževnici je opazen padec EC med zaporednimi odčitki. Za jezero, deževnico in aronjo ni neposredno primerljivih Marcelovih vzorcev.</p>
  </section>

  <section class="mt-6 rounded-card bg-card p-4 shadow-card md:p-6" aria-labelledby="marcel-title">
    <h2 id="marcel-title" class="mt-0 text-[24px]">Marcel · veljavne meritve 2021</h2>
    <p class="text-[15px] text-muted">Razpon najmanjša–največja vrednost, ne interval zaupanja. Oktobrske reke so temperaturno bližje serijskim vzorcem. Reke zajemajo Savo Bohinjko, Savo Dolinko in Radovno; lokacije niso nujno enake današnjim.</p>
    <div class="overflow-x-auto"><table class="w-full min-w-[800px] text-left text-[15px] tabular-nums">
      <caption class="sr-only">Razponi veljavnih Marcelovih meritev</caption>
      <thead><tr><th scope="col" class="p-3">Skupina</th>{fields.map(f => <th scope="col" class="p-3">{f.label}<span class="block text-[12px] font-normal text-muted">{f.unit}</span></th>)}</tr></thead>
      <tbody>{groups.map(g => <tr class="border-t border-line"><th scope="row" class="p-3 font-semibold">{g.label}<span class="block text-[13px] font-normal text-muted">n = {g.rows.length}</span></th>{fields.map((_,i) => <td class="p-3">{range(g.rows,i)}</td>)}</tr>)}</tbody>
    </table></div>
    <p class="text-[14px] text-muted">¹ Zgodovinska tabela označuje prevodnost manj natančno; temperaturna normalizacija ni potrjena. ² Izvorni naslov je Nephelo_counts, vendar stara koda izpisuje polinomsko preračunano vrednost. Manjkajoči spekter enega oktobrskega vodovodnega vzorca ni nadomeščen z ničlo.</p>
    <details class="mt-4 border-t border-line pt-4"><summary class="cursor-pointer text-[16px] font-semibold">Posamezni Marcelovi odčitki in sledljivost</summary>
      <div class="mt-3 overflow-x-auto"><table class="w-full min-w-[850px] text-left text-[14px] tabular-nums"><thead><tr><th class="p-2">Datum / vzorec / vrstica XLSX</th>{fields.map(f => <th class="p-2">{f.label}</th>)}</tr></thead><tbody>{marcel.map(r => <tr class="border-t border-line"><th scope="row" class="p-2 font-normal">{r.date} · {r.sample}<span class="block text-[12px] text-muted">{r.sheet} · vrstica {r.row}</span></th>{r.values.map((v,i) => <td class="p-2">{fmt(v,fields[i].digits)}</td>)}</tr>)}</tbody></table></div>
    </details>
  </section>

  <section class="mt-6 grid gap-5 md:grid-cols-2">
    <div class="rounded-card bg-card p-5 shadow-card"><h2 class="mt-0 text-[22px]">Kaj lahko sklepamo?</h2><ul class="space-y-3 pl-5 text-[16px]"><li><strong>EC Save je v oktobrskem razponu.</strong> To ni dokaz točnosti brez sočasnega referenčnega merilnika.</li><li><strong>Fluorescenčna napetost je nižja.</strong> Ne ločimo učinka vode od premika optičnega ali elektronskega izhodišča.</li><li><strong>Motnosti ne moremo neposredno primerjati.</strong> Različni koeficienti in neznana Marcelova dejanska kalibracija.</li><li><strong>940 nm je blizu zgodovinskim vrednostim.</strong> To ne potrjuje ujemanja celotnega spektra.</li></ul><p class="mb-0 text-[16px] font-semibold">Ponovljivost in razlike med vzorci: da. Dokaz onesnaženja ali varnosti vode: ne.</p></div>
    <div class="rounded-card bg-card p-5 shadow-card"><h2 class="mt-0 text-[22px]">Zakaj stara formula ne zadošča?</h2><p class="text-[15px] text-muted">x = povprečje 16 surovih odčitkov ISL29023. Privzeti formuli:</p><pre class="overflow-x-auto rounded-xl bg-page p-3 text-[13px]">Stara:  0,00004 x² + 0,2253 x − 56,755
FW2:    0,00030 x² + 0,2549 x − 20,979</pre><p class="text-[16px]">Obrat FW2 in uporaba starih privzetih koeficientov za serijske podatke da negativne rezultate. To ni obnovljena Marcelova lestvica in ne dokazuje okvare senzorja. Potrebujemo njegove shranjene koeficiente ter preverjeno optično postavitev.</p><p class="mb-0 text-[15px] font-semibold">Naslednji korak: preveriti CRC, koeficiente in obstojnost po ponovnem zagonu; nato slepi vzorec in znani standardi.</p></div>
  </section>
  <section class="mt-6 text-[14px] text-muted" aria-labelledby="sources-title"><h2 id="sources-title" class="text-[20px] text-ink">Viri in metoda</h2><ul class="space-y-2 pl-5"><li><a class="text-accent" href="/reference/sensor-node-prototype1-measurements-2021-12-10.md">Marcelovo poročilo · prepis DOCX, 10. 12. 2021</a></li><li><a class="text-accent" href="/reference/p3-biosens-report-2021-12-09.md">P3 BioSens · prepis preglednice XLSX</a> — stran uporablja samo liste 29. 10. in 9. 12.; prepis zaradi sledljivosti vsebuje tudi izločene liste.</li><li>Formuli: BioSens, legacy-mega ReadNefelo / CoefDefault in aktivni FW2 ReadNefelo / CoefDefault. Shranjene nastavitve lahko preglasijo privzete koeficiente.</li><li><a href="/meritve.csv" class="text-accent">Izvorne serijske meritve CSV</a> · <a href="/api/readings" class="text-accent">Tekoči API</a></li></ul></section>
</Layout>
<script>import '../scripts/meritve-primerjava.mjs';</script>
