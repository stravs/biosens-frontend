---
// Podatki: for experts. Charts, spectrometer and all readings for a chosen period.
import Layout from '../layouts/Layout.astro';
import TimeBar from '../components/TimeBar.astro';
import ChartStack from '../components/ChartStack.astro';
import { LABEL, LINES, SAMPLE, SPEC } from '../lib/labels.mjs';

const CARD = 'p-4 rounded-card bg-card shadow-card md:px-6 md:py-5';
// Flush under the sticky time bar: 8 px top offset + 60 px controls.
const UNDER_TIMEBAR = 'top-17';
const NOTE = 'my-[1em] max-w-[75ch] text-muted';
---
<Layout view="podatki" title="Podatki">
  <section id="expert">
    <TimeBar />
    <p class="max-w-[75ch] mt-1 text-[16px] text-muted touch:hidden">Namig: z miško povlecite čez graf, da povečate izbrani del. Časi so lokalni.</p>
    <p id="empty" class={NOTE} hidden></p>

    <div id="data">
      <h2>Grafi</h2>
      <p class="flex flex-wrap items-center gap-x-5 gap-y-1.5 max-w-[75ch] mb-3 text-[17px]">
        <span class="inline-flex items-center gap-2 text-muted">Z miško ali prstom pokažite čas – vrednosti se pokažejo v vseh grafih.</span>
      </p>
      <ChartStack id="graphs" timeId="stack-time" top={UNDER_TIMEBAR} items={LINES.map(key => ({ title: LABEL[key] }))} />

      <h2>Spektrometer</h2>
      <ChartStack id="spec-graphs" timeId="spec-time" top={UNDER_TIMEBAR} items={SPEC} class="mb-3" />
      <label class="flex flex-wrap items-center gap-3 my-4 text-[17px] font-semibold">Prikaz spektra
        <select id="spectrum-mode" class="min-h-12 px-3 rounded-xl border border-line bg-card text-ink">
          <option value="measured">Odziv senzorja (a.u.)</option>
          <option value="relative">Glede na običajno stanje (%)</option>
        </select>
      </label>
      <p class="mb-3 text-[16px] text-muted">a.u. = poljubne enote kalibriranega odziva, ne koncentracija. Relativni prikaz primerja signal z mediano naloženih meritev, ne z referenco za meritev prepustnosti. Lestvica ostane enaka znotraj naloženega obdobja.</p>
      <article id="spectrum" class={CARD}></article>
      <article id="spec-heat" class={`${CARD} relative mt-3`}></article>
      <p class={`${NOTE} text-[16px]`}>Vrednost 6.553,5 a.u. lahko pomeni omejitev pri prenosu (nasičenost), ne natančne meritve.</p>

      <details class="group mt-9 px-4.5 rounded-card bg-card shadow-card open:pb-4.5">
        <summary class="flex items-center justify-between py-4.5 list-none cursor-pointer [&::-webkit-details-marker]:hidden after:size-2.5 after:mr-1.5 after:mb-1.5 after:border-r-[2.5px] after:border-b-[2.5px] after:border-muted after:rotate-45 after:transition-transform after:duration-150 group-open:after:mb-0 group-open:after:-rotate-135"><h2 class="m-0">Vse meritve</h2></summary>
        <p id="table-count" class="my-[1em] text-muted"></p>
        <div tabindex="0" class="overflow-x-auto max-h-[85vh] bg-card [&_thead_th]:sticky [&_thead_th]:top-0 [&_thead_th]:bg-card [&_thead_th]:align-bottom [&_:is(th,td):first-child]:sticky [&_:is(th,td):first-child]:left-0 [&_:is(th,td):first-child]:bg-card [&_thead_th:first-child]:z-1"><table class="w-full border-collapse bg-card tabular-nums">
          <thead><tr><th>Čas</th>{SAMPLE.map(([key, f]) => <th>{LABEL[key] ?? f.title}{f.unit && <><br />{f.unit}</>}</th>)}</tr></thead>
          <tbody id="readings"></tbody>
        </table></div>
      </details>
    </div>
    <div class="flex flex-col-reverse gap-3 mt-5 md:flex-row md:justify-end"><button type="button" id="csv" class="w-full min-h-15 rounded-full bg-accent font-bold text-on-accent shadow-card md:w-auto md:min-h-13 md:px-7">Prenesi izbrano obdobje (CSV)</button></div>
  </section>
</Layout>

<script>import '../scripts/podatki.mjs';</script>
