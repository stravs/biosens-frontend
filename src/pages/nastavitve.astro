---
// Nastavitve: normal ranges per measurement, spectrometer alert limits and device limits.
import Layout from '../layouts/Layout.astro';
import { FIELDS } from '../lib/app.mjs';
import { MAIN, SPEC_BY_KEY } from '../lib/labels.mjs';
import { ALERT_KEYS } from '../lib/spectrum.mjs';

const RULE_INPUTS = [['min', 'Od'], ['max', 'Do'], ['change', 'Sprememba v 1 h']];
---
<Layout view="nastavitve" title="Nastavitve">
  <section id="settings">
    <form id="settings-form" novalidate>
      <h2>Običajna območja</h2>
      <p class="muted">Za vsako meritev nastavite običajno območje (od–do) in mejo za hitro spremembo v eni uri. Meritev izven območja ali s hitrejšo spremembo je označena kot nenavadna. Prazno polje pomeni, da pravilo ni nastavljeno.</p>
      <div class="set-cards">
        {Object.entries(MAIN).map(([key, { name }]) => (
          <fieldset class="set-card"><legend>{name}<span class="unit">{FIELDS[key].unit}</span></legend>
            <div class="set-grid">
              {RULE_INPUTS.map(([field, label]) => <label>{label}<input data-rule={key} data-field={field} type="number" inputmode="decimal" step="any"></label>)}
            </div>
          </fieldset>
        ))}
      </div>

      <h2>Spektrometer</h2>
      <p class="muted">Opozori, ko naprava zazna za toliko odstotkov več kot običajno. Običajno je povprečno stanje te naprave v zadnjem tednu. Prazno polje pomeni brez opozorila.</p>
      <div class="set-card set-grid">
        {ALERT_KEYS.map(key => <label><span>{SPEC_BY_KEY[key].title} <span class="unit">%</span></span><input data-rule={key} data-field="max" type="number" inputmode="decimal" step="any"></label>)}
      </div>

      <h2>Naprava</h2>
      <div class="set-card set-grid">
        <label><span>Brez povezave po <span class="unit">min</span></span><input data-setting="offlineMinutes" type="number" inputmode="decimal" step="any"></label>
        <label><span>Dober signal od <span class="unit">dBm</span></span><input data-setting="rssiGood" type="number" inputmode="decimal" step="any"></label>
        <label><span>Slab signal pod <span class="unit">dBm</span></span><input data-setting="rssiWeak" type="number" inputmode="decimal" step="any"></label>
      </div>

      <p id="s-error" class="s-error" role="alert"></p>
      <div class="actions">
        <button type="button" id="s-reset" class="big secondary">Ponastavi na privzeto</button>
        <button type="submit" class="big">Shrani</button>
      </div>
    </form>
  </section>
</Layout>

<script>import '../scripts/nastavitve.mjs';</script>
