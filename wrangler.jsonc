{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biosens-frontend",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API goes through the Worker; the page is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Uplinks from the UG65. Without an id, wrangler creates the database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "biosens", "migrations_dir": "migrations" }]
  // Set DEVICE_EUI with `wrangler secret put DEVICE_EUI` before enabling ingestion.
  // Optional var INGESTION_PAUSED="true" rejects uplinks with 503 during maintenance.
  // Secret UPLINK_TOKEN (wrangler secret put UPLINK_TOKEN): the gateway must send it with each uplink.
}
